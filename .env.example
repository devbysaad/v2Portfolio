# Environment Variables for DevBySaad Portfolio

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/devbysaad"

# ─── Dashboard Auth Token ────────────────────────────────────────
# Generate a random UUID and keep it secret.
# Your dashboard URL will be: yoursite.com/dashboard/<DASHBOARD_TOKEN>
# Generate with: node -e "console.log(require('crypto').randomUUID())"
DASHBOARD_TOKEN="replace-this-with-a-random-uuid"

# ─── Cloudinary (optional, for image uploads) ───────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── App URL ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
